# --- App ---
ATS_APP_NAME=ai-ats
ATS_DEBUG=false
ATS_JWT_SECRET=change-me-in-production
ATS_API_V1_PREFIX=/v1

# --- Database ---
ATS_DB__URL=postgresql+asyncpg://ats:ats@localhost:5432/ats
ATS_DB__POOL_SIZE=10

# --- Redis ---
ATS_REDIS__URL=redis://localhost:6379/0

# --- Vector (qdrant | pgvector) ---
ATS_VECTOR__PROVIDER=qdrant
ATS_VECTOR__URL=http://localhost:6333

# --- Storage (local | s3) ---
ATS_STORAGE__PROVIDER=local
ATS_STORAGE__BUCKET=ats-resumes

# --- Embeddings (bge-small-en-v1.5 | openai | gemini | debug) ---
ATS_EMBEDDING__PROVIDER=bge-small-en-v1.5
ATS_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
ATS_EMBEDDING__DIMENSION=384

# --- LLM (openai | gemini | ollama | vllm | deepseek) ---
ATS_LLM__PROVIDER=openai
ATS_LLM__MODEL=gpt-4o-mini
# ATS_LLM__BASE_URL=http://localhost:11434/v1   # Ollama example

# --- OCR (tesseract | paddle) ---
ATS_OCR__PROVIDER=tesseract

# --- Search / Ranking ---
ATS_SEARCH__TOP_K=50
ATS_SEARCH__LLM_TIMEOUT_MS=4000
ATS_RANKING__SKILL=0.40
ATS_RANKING__EXPERIENCE=0.30
