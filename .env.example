# --- App ---
ATS_APP_NAME=ai-ats
ATS_DEBUG=true

# --- Storage (SQLite + local file uploads; no external services required) ---
ATS_DB__PATH=./data/ats.db
ATS_UPLOAD_DIR=./data/uploads

# --- Ranking weights (sum to ~1.0) ---
ATS_RANKING__SKILL=0.40
ATS_RANKING__EXPERIENCE=0.30
ATS_RANKING__EDUCATION=0.15
ATS_RANKING__CERTIFICATION=0.15

# --- LLM (optional).
# When set, the LLM powers BOTH:
#   1. CV parsing — extracts candidate name/skills/experience/education/certifications
#      from uploaded resumes (deterministic rules are the fallback).
#   2. Ranking — generates per-candidate reasoning and scores.
# If unset, both fall back to the deterministic rule-based engine.
# Points ATS_LLM__BASE_URL at any OpenAI-compatible endpoint (OpenAI, DeepSeek,
# Ollama, vLLM, etc.).
# ATS_LLM__API_KEY=sk-...
# ATS_LLM__BASE_URL=https://api.openai.com/v1
ATS_LLM__MODEL=gpt-4o-mini
ATS_LLM__TIMEOUT_MS=20000

# --- Local BERT resume-NER (optional).
# When ATS_EXTRACT__NER=true, CV parsing uses a local BERT resume-NER model
# (~110M params, runs on CPU in <1s per resume) instead of the LLM, falling
# back to deterministic rules per field. Skips the LLM for extraction.
# Install the extra deps with: pip install -r requirements-ml.txt
# ATS_EXTRACT__NER=true
ATS_EXTRACT__NER_MODEL=yashpwr/resume-ner-bert
ATS_EXTRACT__NER_CONFIDENCE=0.5