# --- App ---
ATS_APP_NAME=ai-ats
ATS_DEBUG=true

# --- Storage (SQLite + local file uploads; no external services required) ---
ATS_DB__PATH=./data/ats.db
ATS_UPLOAD_DIR=./data/uploads

# --- Ranking weights (sum to ~1.0) ---
ATS_RANKING__SKILL=0.40
ATS_RANKING__EXPERIENCE=0.30
ATS_RANKING__EDUCATION=0.15
ATS_RANKING__CERTIFICATION=0.15

# --- LLM (optional).
# When set, the LLM powers BOTH:
#   1. CV parsing — extracts candidate name/skills/experience/education/certifications
#      from uploaded resumes (deterministic rules are the fallback).
#   2. Ranking — generates per-candidate reasoning and scores.
# If unset, both fall back to the deterministic rule-based engine.
# Points ATS_LLM__BASE_URL at any OpenAI-compatible endpoint (OpenAI, DeepSeek,
# Ollama, vLLM, Google Gemini at https://generativelanguage.googleapis.com/v1beta/openai/, etc.).
# The key is read from ATS_LLM__API_KEY, falling back to GEMINI_API_KEY or OPENAI_API_KEY.
# ATS_LLM__API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# ATS_LLM__BASE_URL=https://api.openai.com/v1
ATS_LLM__MODEL=gemini-flash-latest
ATS_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ATS_LLM__TIMEOUT_MS=20000

# --- OpenRouter (optional) ---
# Lets the recruiter-copilot chat switch to any OpenRouter model (e.g. Qwen).
# ATS_OPENROUTER__MODELS is a comma-separated list of OpenRouter model ids.
# ATS_OPENROUTER__API_KEY=sk-or-...
# ATS_OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# ATS_OPENROUTER__MODELS=qwen/qwen-2.5-72b-instruct

# --- Local BERT resume-NER (optional).
# When ATS_EXTRACT__NER=true, CV parsing uses a local BERT resume-NER model
# (~110M params, runs on CPU in <1s per resume) instead of the LLM, falling
# back to deterministic rules per field. Skips the LLM for extraction.
# Install the extra deps with: pip install -r requirements-ml.txt
# ATS_EXTRACT__NER=true
ATS_EXTRACT__NER_MODEL=yashpwr/resume-ner-bert
ATS_EXTRACT__NER_CONFIDENCE=0.5

# --- Semantic search / RAG (optional, opt-in).
# When ATS_RAG__ENABLED=true, jobs and CVs are embedded locally with the free
# BAAI/bge-small-en-v1.5 model (~130 MB, downloads on first use) and stored in
# Qdrant. Qdrant runs in embedded/local mode (files under ATS_QDRANT__PATH, no
# server) unless ATS_QDRANT__URL points at a running server. New data is indexed
# automatically; run POST /api/search/reindex to backfill existing rows.
# ATS_RAG__ENABLED=true
ATS_RAG__EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ATS_RAG__EMBEDDING_DIM=384
ATS_RAG__EMBEDDING_VERSION=bge-small-en-v1.5:v1
ATS_RAG__TOP_K=20
# ATS_QDRANT__PATH=./data/qdrant
# ATS_QDRANT__URL=http://localhost:6333
ATS_QDRANT__COLLECTION=recruitment